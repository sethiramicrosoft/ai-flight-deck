{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-flight-deck.local/schema/control-result.schema.v1.json",
  "title": "AI Flight Deck control result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controlId",
    "controlVersion",
    "instanceId",
    "domainId",
    "cohortId",
    "status",
    "requirement",
    "applicability",
    "observedAt",
    "freshUntil",
    "coverage",
    "provenance",
    "evidenceRefs",
    "affectedPrincipals",
    "affectedResources",
    "limitations"
  ],
  "properties": {
    "authority": {
      "$ref": "evidence-authority.schema.v2.json"
    },
    "controlId": {
      "type": "string",
      "pattern": "^AFD-[A-Z0-9]+-[0-9]{3}$"
    },
    "controlVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "domainId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cohortId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "status": {
      "enum": [
        "Pass",
        "Fail",
        "Warning",
        "Unknown",
        "NotApplicable"
      ]
    },
    "requirement": {
      "enum": [
        "Gate",
        "Advisory"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "reason"
      ],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "applies": {
                "const": false
              }
            },
            "required": [
              "applies"
            ]
          },
          "then": {
            "required": [
              "approvedBy",
              "expiresAt"
            ],
            "properties": {
              "approvedBy": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "observedValue": {},
    "expectedValue": {},
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "freshUntil": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "evaluated",
        "complete"
      ],
      "properties": {
        "population": {
          "type": "integer",
          "minimum": 0
        },
        "evaluated": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "excluded": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "reason": {
          "type": "string",
          "maxLength": 2048
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collectorId",
        "collectorVersion",
        "collectorRunId",
        "tenantId",
        "actorId",
        "source"
      ],
      "properties": {
        "acquisitionMode": {
          "enum": ["LiveGraph", "SignedAttestation", "Imported", "LocalProbe", "Unavailable", "Unspecified"]
        },
        "collectorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "collectorVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "collectorRunId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceVersion": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "requestIds": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "etag": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "affectedPrincipals": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "maxLength": 512
      }
    },
    "affectedResources": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "owner": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "remediation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "NotPlanned",
            "Planned",
            "Approved",
            "Implemented",
            "Verified",
            "Rejected"
          ]
        },
        "action": {
          "type": "string",
          "maxLength": 4096
        },
        "packageId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "attestation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "maxLength": 4096
        },
        "attestedBy": {
          "type": "string",
          "maxLength": 256
        },
        "attestedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  }
}
