{
  "schemaVersion": "1.0",
  "documentType": "tenant-scan",
  "producer": "ai-flight-deck/scan-tenant.ps1",
  "producerVersion": "1.6.0",
  "scoringVersion": "1.3.0",
  "policyVersion": "1.6.0",
  "assessmentType": "microsoft-365-copilot-estate-readiness",
  "readinessCatalog": {
    "path": "schema/readiness-catalog.v1.json",
    "schemaVersion": "1.0",
    "catalogVersion": "1.0.0"
  },
  "controlResultContract": {
    "path": "schema/control-result.schema.v1.json",
    "schemaVersion": "1.0",
    "required": true,
    "defaultCohortId": "tenant-wide",
    "unknownBlocksMissionProgression": true,
    "approvedNotApplicableSatisfiesGate": true,
    "authorityPath": "schema/evidence-authority.schema.v2.json",
    "authorityVersion": "2.0.0",
    "legacyResultsRequireRecollection": true,
    "satisfactionRequiresVerifiedSourceReceipt": true
  },
  "estateDomains": [
    "licensingAndTenantEntitlement",
    "identityAndAccess",
    "devicesAndApps",
    "networkConnectivity",
    "serviceHealthOperations",
    "exchangeOnline",
    "teamsReadiness",
    "sharePointOneDrive",
    "purviewCompliance",
    "securityPosture",
    "copilotConfiguration",
    "powerPlatformAgents",
    "adoptionMeasurementGovernance"
  ],
  "scopeContract": {
    "mode": "bounded-read-only",
    "requiredPermissions": [
      "Directory.Read.All",
      "Organization.Read.All",
      "Sites.Read.All"
    ],
    "contentRetrieved": false,
    "siteSelection": "graph-search-star-candidate-sort-id",
    "itemSelection": "root-children-shared-scope"
  },
  "requiredCollections": [
    "organization",
    "subscribedSkus",
    "users",
    "groups",
    "sites",
    "drives",
    "driveItems",
    "itemSharingEvidence"
  ],
  "evidenceSets": [
    "anonymousPermissionIds",
    "organizationPermissionIds",
    "broadAccessSiteIds",
    "sharedItemIds",
    "permissionPathIds",
    "guestUserIds",
    "criticalEvidenceIds"
  ],
  "evidenceDefinitions": {
    "potentialTenantAudience": {
      "meaning": "A bounded upper estimate of enabled member accounts that may be in scope for tenant-wide sharing paths.",
      "predicate": "The user is a Member account and accountEnabled is true. This is not a per-resource effective-access calculation."
    },
    "sharedItemIds": {
      "meaning": "Risk-qualified exposed items from the bounded root-item sample.",
      "predicate": "The item has a Graph shared facet whose scope is anonymous or organization."
    },
    "permissionPathIds": {
      "meaning": "Stable permission identifiers for the bounded, best-effort detail pass over sampled shared items.",
      "predicate": "The permission was returned by /drives/{driveId}/items/{itemId}/permissions and is bound to the site and item identity."
    },
    "broadAccessSiteIds": {
      "meaning": "Public Microsoft 365 groups that require validation of their connected SharePoint collaboration site.",
      "predicate": "The Microsoft 365 group has visibility Public and groupTypes contains Unified; the scanner separately attempts to resolve /groups/{id}/sites/root."
    }
  },
  "evidenceDetails": {
    "broadAccessSites": "Display name, reason, and administrator action for each SharePoint site connected to a public Microsoft 365 group.",
    "sharedItems": "Object type, display name, SharePoint site, document library, sharing scope, reason, and administrator action for each sampled item with an Anyone or organization-wide sharing link.",
    "permissionPaths": "Best-effort permission detail for sampled shared items, including link scope, direct principal type, roles, inheritance, expiration, guest context, and SharePoint location. Group membership is not expanded."
  },
  "coverageContract": {
    "required": true,
    "siteDiscovery": "Collect Graph search candidates up to validation.maximumSites, deduplicate and sort by site id using ordinal comparison, then select up to scope.maximumSites.",
    "requiredFields": [
      "sitesDiscovered",
      "sitesSelected",
      "sitesScanned",
      "discoveryComplete",
      "selectionComplete",
      "limitReached",
      "complete"
    ],
    "positiveDecisionRequiresComplete": true
  },
  "scoring": {
    "formula": "100 minus bounded penalties from read-only group visibility and risk-qualified item sharing evidence counts",
    "anonymousPermissionPenalty": 15,
    "anonymousPermissionPenaltyCap": 60,
    "organizationPermissionPenalty": 4,
    "organizationPermissionPenaltyCap": 24,
    "broadAccessSitePenalty": 3,
    "broadAccessSitePenaltyCap": 30,
    "sharedItemPenalty": 1,
    "sharedItemPenaltyCap": 20,
    "minimumScore": 0,
    "maximumScore": 100
  },
  "clearance": {
    "minimumReadinessScore": 90,
    "maximumCriticalExposures": 0,
    "requiresImprovement": true,
    "requiresCompleteEvidence": true,
    "requiresCompleteCoverage": true,
    "decisionCodes": [
      "Hold",
      "Remediate",
      "VerifyAgain",
      "SharingControlsVerified"
    ],
    "positiveDecisionCode": "SharingControlsVerified",
    "requiresNoOpenedCriticalEvidence": true
  },
  "rules": {
    "anonymousPermissions": {
      "ruleKey": "AFD-SP-ANONYMOUS-001",
      "severity": "critical"
    },
    "organizationPermissions": {
      "ruleKey": "AFD-SP-ORGANIZATION-001",
      "severity": "high"
    },
    "broadAccessSites": {
      "ruleKey": "AFD-SP-BROAD-001",
      "severity": "high"
    },
    "specificPeopleLinks": {
      "ruleKey": "AFD-SP-SPECIFIC-LINK-001",
      "severity": "low"
    },
    "broadIdentityPermissions": {
      "ruleKey": "AFD-SP-BROAD-IDENTITY-001",
      "severity": "high"
    },
    "guestDirectPermissions": {
      "ruleKey": "AFD-SP-GUEST-DIRECT-001",
      "severity": "high"
    },
    "groupDirectPermissions": {
      "ruleKey": "AFD-SP-GROUP-DIRECT-001",
      "severity": "medium"
    },
    "userDirectPermissions": {
      "ruleKey": "AFD-SP-USER-DIRECT-001",
      "severity": "low"
    },
    "applicationPermissions": {
      "ruleKey": "AFD-SP-APPLICATION-001",
      "severity": "high"
    },
    "inheritedPermissions": {
      "ruleKey": "AFD-SP-INHERITED-001",
      "severity": "medium"
    },
    "unclassifiedPermissions": {
      "ruleKey": "AFD-SP-PERMISSION-UNKNOWN-001",
      "severity": "medium"
    },
    "guestUsers": {
      "ruleKey": "AFD-DIR-GUESTS-001",
      "severity": "medium"
    },
    "incompleteEvidence": {
      "ruleKey": "AFD-COLLECTION-INCOMPLETE-001",
      "severity": "high"
    },
    "noBroadExposure": {
      "ruleKey": "AFD-SCAN-CLEAN-001",
      "severity": "low"
    }
  },
  "validation": {
    "maximumFindings": 100,
    "maximumEvidenceIdsPerSet": 2000000,
    "maximumTextLength": 4096,
    "maximumCount": 2000000000,
    "maximumSites": 10000,
    "maximumDrivesPerSite": 1000,
    "maximumItemsPerDrive": 100000,
    "maximumUsers": 5000000,
    "maximumGroups": 2000000,
    "maximumPermissionsPerSite": 100000,
    "maximumGraphRequests": 2000000
  }
}
