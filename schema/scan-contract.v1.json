{
  "schemaVersion": "1.0",
  "documentType": "tenant-scan",
  "producer": "ai-flight-deck/scan-tenant.ps1",
  "producerVersion": "1.5.0",
  "scoringVersion": "1.3.0",
  "policyVersion": "1.5.0",
  "assessmentType": "microsoft-365-copilot-estate-readiness",
  "readinessCatalog": {
    "path": "schema/readiness-catalog.v1.json",
    "schemaVersion": "1.0",
    "catalogVersion": "1.0.0"
  },
  "controlResultContract": {
    "path": "schema/control-result.schema.v1.json",
    "schemaVersion": "1.0",
    "required": true,
    "defaultCohortId": "tenant-wide",
    "unknownBlocksMissionProgression": true,
    "approvedNotApplicableSatisfiesGate": true
  },
  "estateDomains": [
    "licensingAndTenantEntitlement",
    "identityAndAccess",
    "devicesAndApps",
    "networkConnectivity",
    "serviceHealthOperations",
    "exchangeOnline",
    "teamsReadiness",
    "sharePointOneDrive",
    "purviewCompliance",
    "securityPosture",
    "copilotConfiguration",
    "powerPlatformAgents",
    "adoptionMeasurementGovernance"
  ],
  "scopeContract": {
    "mode": "bounded-read-only",
    "requiredPermissions": [
      "Directory.Read.All",
      "Organization.Read.All",
      "Sites.Read.All"
    ],
    "contentRetrieved": false,
    "siteSelection": "graph-search-star-candidate-sort-id",
    "itemSelection": "root-children-shared-scope"
  },
  "requiredCollections": [
    "organization",
    "subscribedSkus",
    "users",
    "groups",
    "sites",
    "drives",
    "driveItems",
    "itemSharingEvidence"
  ],
  "evidenceSets": [
    "anonymousPermissionIds",
    "organizationPermissionIds",
    "broadAccessSiteIds",
    "sharedItemIds",
    "guestUserIds",
    "criticalEvidenceIds"
  ],
  "evidenceDefinitions": {
    "sharedItemIds": {
      "meaning": "Risk-qualified exposed items from the bounded root-item sample.",
      "predicate": "The item has a Graph shared facet whose scope is anonymous or organization."
    },
    "broadAccessSiteIds": {
      "meaning": "Public Microsoft 365 collaboration workspaces identified from Unified group visibility.",
      "predicate": "The Microsoft 365 group has visibility Public and groupTypes contains Unified."
    }
  },
  "evidenceDetails": {
    "broadAccessSites": "Display name, reason, and administrator action for each public Microsoft 365 workspace evidence identifier."
  },
  "coverageContract": {
    "required": true,
    "siteDiscovery": "Collect Graph search candidates up to validation.maximumSites, deduplicate and sort by site id using ordinal comparison, then select up to scope.maximumSites.",
    "requiredFields": [
      "sitesDiscovered",
      "sitesSelected",
      "sitesScanned",
      "discoveryComplete",
      "selectionComplete",
      "limitReached",
      "complete"
    ],
    "positiveDecisionRequiresComplete": true
  },
  "scoring": {
    "formula": "100 minus bounded penalties from read-only group visibility and risk-qualified item sharing evidence counts",
    "anonymousPermissionPenalty": 15,
    "anonymousPermissionPenaltyCap": 60,
    "organizationPermissionPenalty": 4,
    "organizationPermissionPenaltyCap": 24,
    "broadAccessSitePenalty": 3,
    "broadAccessSitePenaltyCap": 30,
    "sharedItemPenalty": 1,
    "sharedItemPenaltyCap": 20,
    "minimumScore": 0,
    "maximumScore": 100
  },
  "clearance": {
    "minimumReadinessScore": 90,
    "maximumCriticalExposures": 0,
    "requiresImprovement": true,
    "requiresCompleteEvidence": true,
    "requiresCompleteCoverage": true,
    "decisionCodes": [
      "Hold",
      "Remediate",
      "VerifyAgain",
      "SharingControlsVerified"
    ],
    "positiveDecisionCode": "SharingControlsVerified",
    "requiresNoOpenedCriticalEvidence": true
  },
  "rules": {
    "anonymousPermissions": {
      "ruleKey": "AFD-SP-ANONYMOUS-001",
      "severity": "critical"
    },
    "organizationPermissions": {
      "ruleKey": "AFD-SP-ORGANIZATION-001",
      "severity": "high"
    },
    "broadAccessSites": {
      "ruleKey": "AFD-SP-BROAD-001",
      "severity": "high"
    },
    "guestUsers": {
      "ruleKey": "AFD-DIR-GUESTS-001",
      "severity": "medium"
    },
    "incompleteEvidence": {
      "ruleKey": "AFD-COLLECTION-INCOMPLETE-001",
      "severity": "high"
    },
    "noBroadExposure": {
      "ruleKey": "AFD-SCAN-CLEAN-001",
      "severity": "low"
    }
  },
  "validation": {
    "maximumFindings": 100,
    "maximumEvidenceIdsPerSet": 2000000,
    "maximumTextLength": 4096,
    "maximumCount": 2000000000,
    "maximumSites": 10000,
    "maximumDrivesPerSite": 1000,
    "maximumItemsPerDrive": 100000,
    "maximumUsers": 5000000,
    "maximumGroups": 2000000,
    "maximumPermissionsPerSite": 100000,
    "maximumGraphRequests": 2000000
  }
}
